# Index only project-specific docs and HFS+ code, not the inherited Rockbox tree.
/*
!/.xerjignore
!/README.md
!/BUGFIXES.md
!/agents.md
!/shipping.md

!/docs/
/docs/*
!/docs/VERSION
!/docs/hfsplus-audit.md
!/docs/ipod-device-investigation.md
!/docs/next-steps.md
!/docs/hardware-validation.md
!/docs/release-v1.1.md
!/docs/release-v2.0.md
!/docs/release-v2.1.md
!/docs/release-v2.1.1.md
!/docs/v2-issue-map.tsv

!/firmware/
/firmware/*
!/firmware/hfsplus/
!/firmware/hfsplus/**

!/tools/
/tools/*
!/tools/hfsplus/
!/tools/hfsplus/**
!/tools/rockpod/
!/tools/rockpod/**
